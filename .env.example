# 用 deploy/setup.py 生成密钥，切勿使用示例值部署
SECRET_KEY=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=goldetf
POSTGRES_USER=goldetf
# 填已配置的隧道域名（不含 https://）
ALLOWED_HOSTS=gold.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://gold.example.com
PUBLIC_URL=https://gold.example.com
APP_PORT=8088
# 默认监听 NAS 所有网卡；可改 127.0.0.1（仅当隧道进程能访问宿主机回环时）
BIND_IP=0.0.0.0
DEBUG=0
# 恢复演练、核对旧计划时设为 1；核对完成后改回 0 并重建 app 容器
PAUSE_NOTIFICATIONS=0
